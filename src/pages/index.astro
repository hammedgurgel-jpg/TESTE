---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { whyUs } from '../data/whyUs';
---

<Layout
  title="Ancile Engenharia — Segurança contra incêndio em Petrolina e Juazeiro"
  description="Projetos, laudos técnicos e regularização de AVCB/CLCB junto ao Corpo de Bombeiros para edificações em Petrolina, Juazeiro e região."
>
  <section class="container hero">
    <p class="eyebrow">PROJETO E EXECUÇÃO PPCI</p>
    <h1>Segurança contra incêndio, do projeto à aprovação.</h1>
    <p class="lede">
      A {site.name} elabora projetos de incêndio, laudos técnicos e a obtenção de AVCB/CLCB
      para proprietários, síndicos e arquitetos que precisam regularizar edificações junto
      ao Corpo de Bombeiros em {site.areaDeAtuacao}.
    </p>
    <a class="btn btn-primary" href={site.whatsappUrl}>Falar no WhatsApp</a>
  </section>

  <section class="container credential">
    <p class="eyebrow">CREDENCIAL PROFISSIONAL</p>
    <div class="credential-badge">
      <div class="badge-seal" aria-hidden="true">
        <span>CREA</span>
      </div>
      <div class="badge-info">
        <p class="badge-label">Responsável técnico</p>
        <h2>{site.responsavelTecnico}</h2>
        <p class="badge-role">{site.role}</p>
        <p class="badge-crea">{site.creaPe}</p>
      </div>
    </div>
  </section>

  <section class="container why-us">
    <p class="eyebrow">POR QUE NOS ESCOLHER</p>
    <div class="why-list">
      {
        whyUs.map((item) => (
          <div class="why-item">
            <span class="why-number" aria-hidden="true">{item.number}</span>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
          </div>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 88px 32px 96px;
  }
  .eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--accent-2);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: 22px;
  }
  h1 {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 800;
    font-size: clamp(40px, 5.4vw, 68px);
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 22px;
  }
  .lede {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 46ch;
    margin: 0 0 30px;
  }
  .credential {
    padding: 0 32px 96px;
  }
  .credential-badge {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 28px;
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 4px;
    padding: 28px 32px;
  }
  .credential-badge::before,
  .credential-badge::after {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    border: 2px solid var(--accent);
  }
  .credential-badge::before {
    top: -1px;
    left: -1px;
    border-right: none;
    border-bottom: none;
  }
  .credential-badge::after {
    bottom: -1px;
    right: -1px;
    border-left: none;
    border-top: none;
  }
  .badge-seal {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    flex-shrink: 0;
  }
  .badge-seal span {
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--accent-2);
    transform: rotate(-8deg);
  }
  .badge-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 8px;
  }
  .badge-info h2 {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 700;
    font-size: 26px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    margin: 0 0 6px;
  }
  .badge-role {
    font-size: 14px;
    color: var(--text-muted);
    margin: 0 0 12px;
  }
  .badge-crea {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 16px;
    font-weight: 500;
    color: var(--accent-2);
    margin: 0;
  }

  @media (max-width: 560px) {
    .credential-badge {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
  }

  .why-us {
    padding: 0 32px 96px;
  }
  .why-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .why-item {
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 4px;
    padding: 28px 26px;
  }
  .why-number {
    display: block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent-2);
    letter-spacing: 0.06em;
    margin-bottom: 18px;
  }
  .why-item h2 {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 700;
    font-size: 22px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    margin: 0 0 10px;
  }
  .why-item p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  @media (max-width: 800px) {
    .why-list {
      grid-template-columns: 1fr;
    }
  }
</style>
