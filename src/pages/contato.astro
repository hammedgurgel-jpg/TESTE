---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout
  title="Ancile Engenharia — Contato em Petrolina e Juazeiro"
  description="Entre em contato com a Ancile pelo WhatsApp, canal preferencial, ou pelo formulário para tratar de projetos de incêndio e regularização em Petrolina, Juazeiro e região."
>
  <section class="container intro">
    <p class="eyebrow">CONTATO</p>
    <h1>Vamos conversar sobre o seu projeto</h1>
    <p class="lede">
      O WhatsApp é o nosso canal preferencial de resposta rápida. Se preferir, use o formulário
      abaixo e retornamos assim que possível.
    </p>
    <a class="btn btn-primary" href={site.whatsappUrl}>Falar no WhatsApp (canal preferencial)</a>
  </section>

  <section class="container form-section">
    <form name="contato" method="POST" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="contato" />
      <p class="honeypot">
        <label>Não preencha este campo: <input name="bot-field" /></label>
      </p>
      <label for="nome">Nome</label>
      <input type="text" id="nome" name="nome" required />

      <label for="telefone-ou-email">Telefone ou e-mail</label>
      <input type="text" id="telefone-ou-email" name="telefone-ou-email" required />

      <label for="mensagem">Mensagem</label>
      <textarea id="mensagem" name="mensagem" rows="5" required></textarea>

      <button class="btn btn-primary" type="submit">Enviar mensagem</button>
    </form>
  </section>

  <form name="contato" data-netlify="true" netlify-honeypot="bot-field" hidden>
    <input type="hidden" name="form-name" value="contato" />
    <input name="bot-field" />
    <input type="text" name="nome" />
    <input type="text" name="telefone-ou-email" />
    <textarea name="mensagem"></textarea>
  </form>
</Layout>

<style>
  .intro {
    padding: 72px 32px 32px;
  }
  .eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--accent-2);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: 22px;
  }
  h1 {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 800;
    font-size: clamp(32px, 4.4vw, 48px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 22px;
  }
  .lede {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 60ch;
    margin: 0 0 30px;
  }
  .form-section {
    padding: 0 32px 96px;
    max-width: 560px;
  }
  .honeypot {
    display: none;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  form[hidden] {
    display: none;
  }
  label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 12px;
  }
  input[type='text'],
  textarea {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--text);
    font-family: inherit;
    font-size: 15px;
    padding: 12px 14px;
  }
  button {
    margin-top: 22px;
    align-self: flex-start;
  }
</style>
