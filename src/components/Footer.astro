---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <span>{site.name} Engenharia — {site.creaPe}</span>
    <a href={site.whatsappUrl}>{site.whatsappDisplay}</a>
    <span>{site.areaDeAtuacao}</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
  }
  .footer-inner {
    padding: 26px 32px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: var(--text-muted);
  }
  .footer-inner a {
    color: var(--accent-2);
    text-decoration: none;
  }
</style>
