---
import { site } from '../data/site';
---

<div class="credential-badge">
  <div class="badge-seal" aria-hidden="true">
    <span>CREA</span>
  </div>
  <div class="badge-info">
    <p class="badge-label">Responsável técnico</p>
    <h2>{site.responsavelTecnico}</h2>
    <p class="badge-role">{site.role}</p>
    <p class="badge-crea">{site.creaPe}</p>
  </div>
</div>

<style>
  .credential-badge {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 28px;
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 4px;
    padding: 28px 32px;
  }
  .credential-badge::before,
  .credential-badge::after {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    border: 2px solid var(--accent);
  }
  .credential-badge::before {
    top: -1px;
    left: -1px;
    border-right: none;
    border-bottom: none;
  }
  .credential-badge::after {
    bottom: -1px;
    right: -1px;
    border-left: none;
    border-top: none;
  }
  .badge-seal {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    flex-shrink: 0;
  }
  .badge-seal span {
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--accent-2);
    transform: rotate(-8deg);
  }
  .badge-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 8px;
  }
  .badge-info h2 {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 700;
    font-size: 26px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    margin: 0 0 6px;
  }
  .badge-role {
    font-size: 14px;
    color: var(--text-muted);
    margin: 0 0 12px;
  }
  .badge-crea {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 16px;
    font-weight: 500;
    color: var(--accent-2);
    margin: 0;
  }

  @media (max-width: 560px) {
    .credential-badge {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
  }
</style>
