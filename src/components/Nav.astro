---
import { navLinks, site } from '../data/site';
---

<nav class="site-nav">
  <div class="container nav-inner">
    <a class="brand" href="/">Ancile<span>·</span>Eng.</a>
    <div class="navlinks">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
    <a class="navcta" href={site.whatsappUrl}>WhatsApp</a>
  </div>
</nav>

<style>
  .site-nav {
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 22px 32px;
    flex-wrap: wrap;
  }
  .brand {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 800;
    font-size: 22px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    margin-right: auto;
    text-decoration: none;
  }
  .brand span {
    color: var(--accent);
  }
  .navlinks {
    display: flex;
    gap: 26px;
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
  }
  .navlinks a {
    text-decoration: none;
    color: inherit;
  }
  .navlinks a:hover {
    color: var(--text);
  }
  .navcta {
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    font-size: 13px;
    padding: 9px 16px;
    border-radius: 3px;
    text-decoration: none;
  }
</style>
