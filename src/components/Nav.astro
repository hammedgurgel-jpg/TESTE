---
import { navLinks, site } from '../data/site';
---

<nav class="site-nav">
  <div class="container nav-inner">
    <a class="brand" href="/">Ancile<span>·</span>Eng.</a>
    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Abrir menu"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
    <div class="navlinks" id="nav-menu">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
    <a class="navcta" href={site.whatsappUrl}>WhatsApp</a>
  </div>
</nav>

<style>
  .site-nav {
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 22px 32px;
    flex-wrap: wrap;
  }
  .brand {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 800;
    font-size: 22px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    margin-right: auto;
    text-decoration: none;
  }
  .brand span {
    color: var(--accent);
  }
  .navlinks {
    display: flex;
    gap: 26px;
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
  }
  .navlinks a {
    text-decoration: none;
    color: inherit;
  }
  .navlinks a:hover {
    color: var(--text);
  }
  .navcta {
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    font-size: 13px;
    padding: 9px 16px;
    border-radius: 3px;
    text-decoration: none;
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    order: -1;
  }
  .nav-toggle-bar {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--text);
    border-radius: 1px;
  }
  @media (max-width: 720px) {
    .nav-toggle {
      display: flex;
    }
    .navlinks {
      display: none;
      order: 3;
      flex-direction: column;
      gap: 16px;
      width: 100%;
    }
    .navlinks.is-open {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('nav-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Fechar menu' : 'Abrir menu');
  });
</script>
